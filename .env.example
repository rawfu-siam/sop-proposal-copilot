# OpenAI API configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store persistence
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=sop_proposal_knowledge

# Outbound Slack & n8n webhook integrations
SLACK_WEBHOOK_URL=YOUR_SLACK_URL
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/sop-proposal-handoff
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_MAX_RETRIES=3

# Application & logging configuration
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_NAME=copilot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# RAG & agent guardrails
RETRIEVAL_TOP_K=4
CONFIDENCE_THRESHOLD=0.65
